{
  "manifest_version": 3,
  "name": "Futuret3ch Shield",
  "version": "1.0.0",
  "description": "Shield companion for Firefox. Hub, trial, Guide. Not a full-disk scanner.",
  "browser_specific_settings": {
    "gecko": { "id": "shield@futuret3ch.com.au", "strict_min_version": "109.0" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Shield",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://memetorrent.futuret3ch.com.au/*",
    "https://*.futuret3ch.com.au/*"
  ]
}
