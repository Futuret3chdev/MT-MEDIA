{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "devCommand": "next dev --port $PORT",
  "rewrites": [
    {
      "destination": "/auth.txt",
      "source": "/auth.php"
    },
    {
      "destination": "/callback.txt",
      "source": "/callback.php"
    },
    {
      "destination": "/logout.txt",
      "source": "/logout.php"
    },
    {
      "destination": "/get-latest-scam.txt",
      "source": "/get-latest-scam.php"
    },
    {
      "destination": "/submit-scam.txt",
      "source": "/submit-scam.php"
    },
    {
      "destination": "/sendToTelegram.txt",
      "source": "/sendToTelegram.php"
    },
    {
      "destination": "/telegram-webhook.txt",
      "source": "/telegram-webhook.php"
    },
    {
      "destination": "/wallet_callback.txt",
      "source": "/wallet_callback.php"
    },
    {
      "destination": "/update_discord_verification.txt",
      "source": "/update_discord_verification.php"
    },
    {
      "destination": "/store_discord_member.txt",
      "source": "/store_discord_member.php"
    },
    {
      "destination": "https://futuret3ch.com.au/message_counts.php",
      "source": "/message_counts.php"
    },
    {
      "source": "/games/api/discord-callback.php",
      "destination": "/api/oauth/discord/callback"
    }
  ],
  "headers": [
    {
      "source": "/games/gallery/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
